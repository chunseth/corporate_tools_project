<h1>Corporate Tools Dashboard</h1>

<section>
    <h2>Ticket Summary</h2>
    <div class="ticket-summary">
        <div class="ticket-summary-content">
            <p>Open: <%= @open_tickets %></p>
            <p>In progress: <%= @in_progress_tickets %></p>
            <p>Completed: <%= @completed_tickets %></p>
        </div>
    </div>
</section>

<h2>Recent Tickets</h2>

<%= form_with url: root_path, method: :get do |form| %>
    <%= form.label :status, "Filter by status" %>

    <%= form.select :status, [["All tickets", ""], ["Open", "open"], ["In progress", "in_progress"], ["Completed", "completed"]], selected: @status_filter %>
    <%= form.submit "Filter" %>
<% end %>

<%= form_with url: root_path, method: :get do |form| %>
    <%= form.label :priority, "Filter by priority" %>

    <%= form.select :priority, [["All priority", ""], ["Low", "low"], ["Medium", "medium"], ["High", "high"]], selected: @priority_filter %>
    <%= form.submit "Filter" %>
<% end %>

<% if @tickets.any? %>
    <ul class="ticket-list">
        <% @tickets.each do |ticket| %>
            <li class="ticket-card">
                <div>
                    <strong><%= link_to ticket.title, ticket_path(ticket) %></strong>
                    <p><%= ticket.description %></p>
                </div>

                <div class="ticket-meta">
                    <span><%= ticket.status %></span>
                    <span><%= ticket.priority %></span>
                </div>
            </li>
        <% end %>
    </ul>
<% else %>
    <p>No tickets yet.</p>
<% end %>

<%= link_to "Create a new ticket", new_ticket_path %>
