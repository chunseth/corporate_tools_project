<h1>Corporate Tools Dashboard</h1>

<section>
    <h2>Ticket Summary</h2>

    <p>Open: <%= @open_tickets %></p>
    <p>In progress: <%= @in_progress_tickets %></p>
    <p>Completed: <%= @completed_tickets %></p>
</section>

<h2>Recent Tickets</h2>

<%= form_with url: root_path, method: :get do |form| %>
    <%= form.label :status, "Filter by status" %>

    <%= form.select :status, [["All tickets", ""], ["Open", "open"], ["In progress", "in_progress"], ["Completed", "completed"]], selected: @status_filter %>

    <%= form.submit "Filter" %>
<% end %>

<% if @tickets.any? %>
    <ul>
        <% @tickets.each do |ticket| %>
            <li>
                <strong><%= link_to ticket.title, ticket_path(ticket) %></strong>
                - <%= ticket.status %>
                - <%= ticket.priority %>
            </li>
        <% end %>
    </ul>
<% else %>
    <p>No tickets yet.</p>
<% end %>

<%= link_to "Create a new ticket", new_ticket_path %>
