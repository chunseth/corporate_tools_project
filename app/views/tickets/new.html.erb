<h1>New Tickets</h1>

<% if @ticket.errors.any? %>
    <div> 
        <h2><%= pluralize(@ticket.errors.count, "error") %> prevented this ticket from being saved:</h2>
    
        <ul>
            <% @ticket.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
        </ul>
    </div>
<% end %>

<%= form_with model: @ticket do |form| %>
    <div> 
        <%= form.label :title %>
        <%= form.text_field :title %>
    </div>

    <div>
        <%= form.label :description %>
        <%= form.text_area :description %>
    </div>

    <div>
        <%= form.label :status %>
        <%= form.select :status, ["open", "in_progress", "completed"] %>
    </div>

    <div>
        <%= form.label :priority %>
        <%= form.select :priority, ["low", "medium", "high"] %>
    </div>

    <%= form.submit "Create Ticket" %>
<% end %>